# Скопируйте в .env и задайте свои значения: cp .env.example .env
POSTGRES_USER=traker
POSTGRES_PASSWORD=смените-пароль-базы
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=смените-на-длинный-случайный-ключ
CORS_ORIGINS=http://localhost
APP_PORT=80
DB_PORT=5433
LOG_LEVEL=INFO
GRAFANA_PASSWORD=смените-пароль-grafana
# Образы из GitHub Container Registry (используются при деплое из CI/CD)
IMAGE_PREFIX=ghcr.io/m8x3a2/traker000
IMAGE_TAG=latest
